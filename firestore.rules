rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if true;
      allow write: if request.resource.data.size() <= 10;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.text is string
                      && request.resource.data.text.size() <= 1000
                      && request.resource.data.senderName is string
                      && request.resource.data.senderName.size() <= 100;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if false;
      }
    }

    match /visitors/{visitorId} {
      allow read: if true;
      allow create: if request.resource.data.visitorId is string
                    && request.resource.data.firstVisitAt is number
                    && request.resource.data.visitCount is number;
      allow update: if request.resource.data.visitorId is string
                    && request.resource.data.lastVisitAt is number;
      allow delete: if false;
    }
  }
}

